# Server Configuration
PORT=5122

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=executive_ai_db

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Google OAuth2 Credentials (Gmail API)
