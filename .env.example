GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5122/auth/google/callback

# WhatsApp Numbers (in international format without + or spaces, e.g. 919876543210)
DIRECTOR_PHONE=
PA_PHONE=

# University / Organization Branding
ORGANIZATION_NAME=JECRC University
DIRECTOR_TITLE=Prof. (Dr.) Director
BRIEFING_TIME=08:00
